#!/usr/bin/env bash
# Runs the non-test half of `just ci` before every push.
#
# Why a hook and not a line in a guide: every gate this repository lost time to
# recently was a gate that EXISTED and was CORRECT, and simply was not run --
# broken intra-doc links, a clippy pass missing `--locked`, a second clippy
# invocation nobody knew about. Prose telling people to run `just ci` had been
# in AGENTS.md the whole time.
#
# The test suite is deliberately NOT here. Every one of those misses was caught
# by a cheap gate; tests take minutes and a hook people disable is worth less
# than a hook they keep. Tests still run in CI.
#
# Most markdown-only pushes use the text fast path below. Markdown files that
# are themselves inputs to contract gates stay on the full path.
#
# Escape hatch: `git push --no-verify`. If you use it, CI is your gate.
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
    printf 'pre-push: `just` not found -- skipping the local gate.\n' >&2
    printf '          Install it (https://just.systems) or push with --no-verify.\n' >&2
    exit 0
fi

ZERO_SHA=0000000000000000000000000000000000000000
declare -a push_ranges=()
declare -a changed_paths=()

is_contract_gate_input() {
    case "$1" in
        AGENTS.md|README.md|docs/crates.md|docs/PORT.md|docs/architecture.md) return 0 ;;
        crates/flui-scheduler/README.md|crates/flui-scheduler/CHANGELOG.md) return 0 ;;
        crates/flui-platform/README.md) return 0 ;;
        docs/adr/ADR-[0-9][0-9][0-9][0-9]-*.md) return 0 ;;
        *) return 1 ;;
    esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_ref" != refs/heads/* ]]; then
        printf 'pre-push: non-branch ref %s -- running full gate.\n' "$local_ref" >&2
        push_ranges=()
        changed_paths=(force_full_gate)
        break
    fi

    if [[ "$local_sha" == "$ZERO_SHA" ]]; then
        # Deleting a branch cannot introduce broken code or docs.
        continue
    fi

    if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
        if git rev-parse --verify origin/main >/dev/null 2>&1; then
            base_sha=$(git merge-base "$local_sha" origin/main)
        else
            printf 'pre-push: origin/main unavailable for new branch -- running full gate.\n' >&2
            push_ranges=()
            changed_paths=(force_full_gate)
            break
        fi
    else
        base_sha="$remote_sha"
    fi

    push_ranges+=("$base_sha..$local_sha")
    while IFS= read -r path; do
        [[ -n "$path" ]] && changed_paths+=("$path")
    done < <(git diff --name-only --no-renames --diff-filter=ACMRD "$base_sha..$local_sha")
done

if ((${#push_ranges[@]} > 0)) && ((${#changed_paths[@]} > 0)); then
    markdown_only=1
    for path in "${changed_paths[@]}"; do
        case "$path" in
            *.md|*.mdx)
                if is_contract_gate_input "$path"; then
                    markdown_only=0
                    break
                fi
                ;;
            *)
                markdown_only=0
                break
                ;;
        esac
    done

    if ((markdown_only)); then
        printf 'pre-push: markdown-only changes detected -- running whitespace + text checks...\n' >&2
        for range in "${push_ranges[@]}"; do
            git diff --check "$range"
        done
        just text-check
        exit 0
    fi
fi

printf 'pre-push: running `just gate` (fmt, lints, docs, contract checks)...\n' >&2
if ! just gate; then
    printf '\npre-push: the local gate failed. Fix it, or push with --no-verify if\n' >&2
    printf '          you have a reason and CI will catch it.\n' >&2
    exit 1
fi
