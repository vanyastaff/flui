// Every token the scanner must report, one per guarded body (9 in total).
impl ViewState<V> for S {
    fn build(&self, _v: &V, cx: &dyn BuildContext) -> impl IntoView {
        let r = cx.reactive();
        self.count.set(&r, 1); // a write from build re-marks this frame's readers
        self.count.update(&r, |c| *c += 1);
        let leaked = cx.signal(0u32); // a slot per rebuild
        let leaked2 = r.signal_owned_by(cx.element_id(), 0u32);
        SizedBox::square(1.0)
    }
}
impl RenderBox for R {
    fn perform_layout(&mut self, cx: &mut LayoutCx) -> Size {
        self.width.set_if_changed(&cx.reactive(), 2.0);
        self.width.set(
            &*r,
            3.0,
        );
        let _s = r.try_signal(1u8);
        Size::ZERO
    }
    fn paint(&self, cx: &mut PaintCx) {
        self.flag.update(
            &r,
            |f| *f = true,
        );
        let _s = r.try_signal_owned_by(id, 1u8);
    }
}
