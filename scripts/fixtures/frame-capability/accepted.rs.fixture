// Fixture for port-check trigger #22 — MUST pass.
//
// The sanctioned shape for every lifecycle-only frame capability: acquire in a
// lifecycle hook, store, fire later.

impl ViewState<Async> for AsyncState {
    fn init_state(&mut self, ctx: &dyn BuildContext) {
        self.handle = Some(ctx.rebuild_handle());
        self.post_frame = ctx.post_frame_handle();
        self.local_post_frame = ctx.local_post_frame_handle();
        self.text_input = ctx.text_input_handle();
        self.hit_test = ctx.hit_test_handle();
        self.focus = Some(ctx.focus_manager());
    }

    fn did_change_dependencies(&mut self, ctx: &dyn BuildContext) {
        self.handle = Some(ctx.rebuild_handle());
        self.post_frame = ctx.post_frame_handle();
        self.local_post_frame = ctx.local_post_frame_handle();
        self.text_input = ctx.text_input_handle();
        self.hit_test = ctx.hit_test_handle();
        self.focus = Some(ctx.focus_manager());
    }

    // `build` only READS state the callback wrote. It never acquires a handle.
    fn build(&self, _view: &Async, _ctx: &dyn BuildContext) -> impl IntoView {
        let snapshot = self.cell.lock().clone();
        Text::new(format!("{snapshot:?}"))
    }
}

impl AsyncState {
    /// Fired from a worker thread, long after `build` returned.
    fn on_complete(&self, value: u32) {
        *self.cell.lock() = Some(value);
        if let Some(handle) = &self.handle {
            handle.schedule();
        }
        if let Some(post_frame) = &self.post_frame {
            post_frame.schedule(|_timing| {});
        }
        if let Some(focus) = &self.focus {
            focus.unfocus();
        }
    }
}

// The framework itself mints handles outside any guarded body.
fn make_build_ctx(core: &ElementCore, owner: &ElementOwner) -> BuildCtx<'_> {
    BuildCtx::new(
        core.self_id(),
        core.depth(),
        owner.tree(),
        core.rebuild_handle(),
        owner.post_frame_handle.clone(),
    )
}

// `pipeline_owner()` is acquired in `init_state`, same as the other five, but
// stored under a name that does not repeat the guarded token
// (`pipeline_cell`, not `pipeline_owner`) — real production code
// (`InteractiveViewerState`) clones the stored handle forward into `build`'s
// own gesture closures, and a scanner with no method-call parse would flag
// that re-clone identically to a fresh acquisition if the stored name still
// read `pipeline_owner`.
impl ViewState<InteractiveViewer> for InteractiveViewerState {
    fn init_state(&mut self, ctx: &dyn BuildContext) {
        self.pipeline_cell = ctx.pipeline_owner();
    }

    fn build(&self, _view: &InteractiveViewer, _ctx: &dyn BuildContext) -> impl IntoView {
        let pipeline_cell = self.pipeline_cell.clone();
        AnimatedBuilder::new(self.listenable.clone(), move || {
            let pipeline_cell = pipeline_cell.clone();
            let pan_update = move |_details: DragUpdateDetails| {
                if let Some(owner) = &pipeline_cell {
                    owner.with(|owner| owner.box_size(RenderId::new(1)));
                }
            };
            GestureDetector::new().on_pan_update(pan_update)
        })
    }
}
