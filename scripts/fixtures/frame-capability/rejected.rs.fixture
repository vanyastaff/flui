// Fixture for port-check trigger #22 — MUST be rejected.
//
// Not compiled: the `.fixture` extension keeps it out of `cargo` and out of the
// scanner's own `*.rs` sweep over `crates/`.
//
// Every body below acquires a LIFECYCLE-ONLY CAPABILITY from inside a frame
// phase. Every guarded token appears, so adding a capability to the scanner
// without adding a fixture cannot create a false sense of coverage.
//
// Prose mentioning rebuild_handle, post_frame_handle, local_post_frame_handle,
// text_input_handle, focus_manager, keep_alive_lease, keep_alive_handle,
// owner_platform, hit_test_handle, or
// pipeline_owner in a
// comment must NOT count as a violation; this line proves the comment filter
// works.

impl StatelessView for Loop {
    fn build(&self, ctx: &dyn BuildContext) -> impl IntoView {
        // Unbounded rebuild loop: schedule from the very phase that is building.
        let handle = ctx.rebuild_handle();
        handle.schedule();
        // Queues work against the frame that is still building.
        let post = ctx.post_frame_handle();
        // Same hazard, `!Send` handle: queues owner-local work against the
        // frame that is still building.
        let local_post = ctx.local_post_frame_handle();
        // Re-attaches the IME client on every rebuild.
        let text_input = ctx.text_input_handle();
        // Makes imperative focus mutation reachable from build.
        let focus = ctx.focus_manager();
        // Re-takes the keep-alive hold on every rebuild; the previous lease's
        // Drop releases it, so the child's survival would hinge on rebuild
        // ordering rather than on the state that wants it kept alive.
        let keep_alive = ctx.keep_alive_lease();
        // Same hazard in retained form: a fresh handle every rebuild.
        let keep_alive_capability = ctx.keep_alive_handle();
        // Ambient owner-thread platform access from mid-frame presentation
        // code (ADR-0039 §6) — the same hazard trigger #22 exists to fence.
        with_owner_platform(|owner| owner.quit());
        // A live PipelineCell handle, reentered synchronously from the very
        // phase that is building — PipelineCell::with_mut's own reentrancy
        // guard would panic on this, but the guard should never be reached
        // in the first place.
        let pipeline = ctx.pipeline_owner();
        pipeline.unwrap().with_mut(|owner| owner.clear_all_dirty_nodes());
        // Reads the render tree at a position from inside the phase that is
        // still mutating it, so the answer describes a half-built tree.
        let probe = ctx.hit_test_handle();
        Text::new("boom")
    }
}

impl RenderBox for Bad {
    fn perform_layout(&mut self, ctx: &mut BoxLayoutContext<'_>) -> Size {
        let nested = if true {
            let handle = self.ctx.rebuild_handle();
            handle.schedule();
            1
        } else {
            0
        };
        Size::ZERO
    }

    fn paint(&self, ctx: &mut PaintContext<'_>) {
        self.ctx.rebuild_handle().schedule();
        self.ctx.post_frame_handle().unwrap().schedule(|_| {});
    }
}
