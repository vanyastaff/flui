<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleName</key>
    <string>IosDemo</string>
    <key>CFBundleDisplayName</key>
    <string>FLUI Demo</string>
    <key>CFBundleIdentifier</key>
    <string>dev.flui.ios-demo</string>
    <key>CFBundleExecutable</key>
    <string>ios_demo</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- The demo renders its own Metal-backed surface; no storyboard or scene
         manifest is needed because `UIApplicationMain` installs our delegate
         class directly (see `platforms/ios/platform.rs`). -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIHighResolutionCapable</key>
    <true/>
</dict>
</plist>
