+    }
+
+    /// The share of the content the node shows on one axis, from 0 to 100:
+    /// its own extent over that extent plus the scroll range. An axis that
+    /// does not scroll shows all of it.
+    fn scroll_view_size(&self, horizontal: bool) -> f64 {
+        let viewport = self.node.raw_bounds().map(|bounds| {
+            if horizontal {
+                bounds.width()
+            } else {
+                bounds.height()
+            }
+        });
+        match (self.scroll_extents(horizontal), viewport) {
+            (Some((min, max)), Some(viewport)) if max > min && viewport > 0.0 => {
