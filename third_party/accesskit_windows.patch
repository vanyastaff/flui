+    /// The node's scroll extents on one axis, as (minimum, maximum), when it
+    /// publishes both and they are finite and ordered.
+    fn scroll_extents(&self, horizontal: bool) -> Option<(f64, f64)> {
+        let (min, max) = if horizontal {
+            (self.node.scroll_x_min()?, self.node.scroll_x_max()?)
+        } else {
+            (self.node.scroll_y_min()?, self.node.scroll_y_max()?)
+        };
+        (min.is_finite() && max.is_finite() && min <= max).then_some((min, max))
+    }
+
+    /// The node's scroll position on one axis, when it publishes a finite one.
+    fn scroll_position(&self, horizontal: bool) -> Option<f64> {
+        let position = if horizontal {
+            self.node.scroll_x()
+        } else {
+            self.node.scroll_y()
+        };
+        position.filter(|position| position.is_finite())
+    }
+
+    fn is_scroll_pattern_supported(&self) -> bool {
+        self.scroll_extents(true).is_some() || self.scroll_extents(false).is_some()
+    }
+
+    fn is_scrollable(&self, horizontal: bool) -> bool {
+        self.scroll_extents(horizontal)
+            .is_some_and(|(min, max)| max > min)
+    }
+
+    fn is_horizontally_scrollable(&self) -> bool {
+        self.is_scrollable(true)
+    }
+
+    fn is_vertically_scrollable(&self) -> bool {
+        self.is_scrollable(false)
+    }
+
+    /// How far along its extents the position is, from 0 to 100, or
+    /// `UIA_ScrollPatternNoScroll` when the axis does not scroll or the
+    /// position is unknown.
+    fn scroll_percent(&self, horizontal: bool) -> f64 {
+        match (
+            self.scroll_extents(horizontal),
+            self.scroll_position(horizontal),
+        ) {
+            (Some((min, max)), Some(position)) if max > min => {
+                ((position - min) / (max - min) * 100.0).clamp(0.0, 100.0)
+            }
+            _ => UIA_ScrollPatternNoScroll,
+        }
+    }
+
+    fn horizontal_scroll_percent(&self) -> f64 {
+        self.scroll_percent(true)
+    }
+
+    fn vertical_scroll_percent(&self) -> f64 {
