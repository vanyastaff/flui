+    /// The position `percent` of the extents asks for on one axis: `None`
+    /// for `UIA_ScrollPatternNoScroll`, which leaves the axis where it is.
+    fn scroll_target(&self, horizontal: bool, percent: f64) -> Result<Option<f64>> {
+        if percent == UIA_ScrollPatternNoScroll {
+            return Ok(None);
+        }
