# Native libraries (generated)
platforms/android/app/src/main/jniLibs/

# Gradle build outputs
platforms/android/app/build/
platforms/android/build/
platforms/android/.gradle/

# Local configuration
platforms/android/local.properties

# Signing configs
platforms/android/*.keystore
platforms/android/*.jks

# ═══════════════════════════════════════════════════════════════════════════════
# Web / WASM
# ═══════════════════════════════════════════════════════════════════════════════

# Build outputs
platforms/web/dist/
platforms/web/pkg/

# Node modules (if using npm/yarn for web tooling)
node_modules/
package-lock.json
# A root package.json only ever held a local agent's MCP server; the project
# has no npm surface of its own.
/package.json

# Python bytecode (tools/device-checks, tools/text-spike).
__pycache__/
yarn.lock

