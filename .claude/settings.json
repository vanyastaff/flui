{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rust-studio": {
      "source": {
        "source": "github",
        "repo": "vanyastaff/rust-studio"
      }
    }
  },
  "enabledPlugins": {
    "rust-studio@rust-studio": true
  },
  "env": {
    "RUST_STUDIO_MEMORY_RECALL": "off",
    "RUST_STUDIO_ROUTING_NUDGE": "off",
    "RUST_STUDIO_LIFECYCLE_NOTES": "off",
    "RUST_STUDIO_AUTO_CAPTURE": "off"
  }
}
