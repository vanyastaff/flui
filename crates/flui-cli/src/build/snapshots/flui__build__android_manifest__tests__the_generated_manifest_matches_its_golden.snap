---
source: crates/flui-cli/src/build/android_manifest.rs
expression: "render(&FACTS, &framework_declarations())"
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by `flui build` from flui.toml and the declarations of the
     crates the app links (`[package.metadata.flui.declares]`, ADR-0307).
     Every build writes it again: change flui.toml or the crate instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- No resources: the platform's default launcher icon applies.
         `hasCode`: the APK carries FLUI's Java classes, the dex of the crates
         the app links, which the Activity below is one of (ADR-0255).
         `enableOnBackInvokedCallback`: back arrives as predictive back, which
         FLUI handles only while it can pop. -->
    <application
        android:label="R&amp;D &lt;Notes&gt;"
        android:hasCode="true"
        android:enableOnBackInvokedCallback="true">
        <!-- Android recreates the Activity for a configuration change the app
             does not declare, which restarts `android_main` and loses the
             app's state. FLUI follows these in place: `ConfigChanged` reads the
             window, the displays, night mode, text sizing and preferences
             again, and a keyboard or navigation device only delivers input.
             A language change still recreates it: the host does not follow
             the locale yet. `fontWeightAdjustment` needs an API 31 or later
             platform to link. `singleTop`: a new intent reaches the running
             Activity instead of starting a second one with a second Rust
             runtime. -->
        <activity
            android:name="dev.flui.platform.FluiActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation"
            android:label="R&amp;D &lt;Notes&gt;">
            <meta-data
                android:name="android.app.lib_name"
                android:value="notes" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
