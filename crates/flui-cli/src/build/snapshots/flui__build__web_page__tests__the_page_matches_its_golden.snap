---
source: crates/flui-cli/src/build/web_page.rs
expression: "render(\"Demo\", &page(\"/\"))"
---
<!DOCTYPE html>
<!-- Written by `flui build` on every build; edits here are lost. -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <base href="/">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Demo">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Demo</title>
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="flui.css">
</head>
<body>
    <script type="module" src="flui.js"></script>
</body>
</html>
